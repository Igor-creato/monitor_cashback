COMPOSE_PROJECT_NAME=monitor_cashback
PRICE_MONITOR_BIND_ADDRESS=127.0.0.1
PRICE_MONITOR_ENVIRONMENT=development
PRICE_MONITOR_EXTERNAL_BASE_URL=http://localhost:8000
POSTGRES_DB=price_monitor
POSTGRES_USER=price_monitor
POSTGRES_PASSWORD=synthetic-local-postgres-password
RABBITMQ_DEFAULT_USER=price_monitor
RABBITMQ_DEFAULT_PASS=synthetic-local-rabbitmq-password
PRICE_MONITOR_DATABASE_URL=postgresql+psycopg://price_monitor:synthetic-local-postgres-password@postgres:5432/price_monitor
PRICE_MONITOR_REDIS_URL=redis://redis:6379/0
PRICE_MONITOR_RABBITMQ_URL=amqp://price_monitor:synthetic-local-rabbitmq-password@rabbitmq:5672//
PRICE_MONITOR_HMAC_SECRETS=synthetic-local-secret-change-me
PRICE_MONITOR_HMAC_REPLAY_WINDOW_SECONDS=300
PRICE_MONITOR_DB_POOL_RECYCLE_SECONDS=3600
